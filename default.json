{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "baseBranchPatterns": [
        "dev"
    ],
    "dependencyDashboard": true,
    "labels": [
        "dependencies"
    ],
    "branchPrefix": "deps/",
    "extends": [
        "config:recommended"
    ],
    "timezone": "Europe/Berlin",
    "schedule": [
        "before 6am on monday"
    ],
    "reviewers": [
        "RainbowDashLabs"
    ],
    "prConcurrentLimit": 3,
    "prHourlyLimit": 10,
    "packageRules": [
        {
            "description": "npm packages wait 14 days after release",
            "matchManagers": [
                "npm"
            ],
            "minimumReleaseAge": "14 days"
        },
        {
            "description": "Auto-merge minor and patch updates",
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "automerge": true,
            "automergeType": "branch"
        },
        {
            "description": "Major updates require a PR and manual approval",
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false
        },
        {
            "description": "Group all non-major dependency updates",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "all non-major dependencies",
            "groupSlug": "all-minor-patch"
        },
        {
            "description": "Group all major updates",
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "major updates",
            "groupSlug": "major"
        },
        {
            "description": "Towny minor and patch updates once a month",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "matchPackageNames": [
                "com.github.TownyAdvanced:Towny"
            ],
            "schedule": [
                "on the first day of the month"
            ]
        },
        {
            "description": "Server APIs and their test servers are updated by hand, together with the supported server version",
            "matchPackageNames": [
                "io.papermc.paper:paper-api",
                "org.spigotmc:spigot-api",
                "/^com\\.github\\.seeseemelk:MockBukkit-.+$/",
                "/^org\\.mockbukkit\\.mockbukkit:mockbukkit-.+$/"
            ],
            "enabled": false
        }
    ]
}
